# Copy to a private file (do not commit secrets) and customize.
# Each command MUST emit a tx hash (0x + 64 hex) on success.

# Required tx commands
BOOTSTRAP_TX_CMD='echo 0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
UPDATE_TX_CMD='echo 0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
NEG_INVALID_SIGNER_SET_TX_CMD='echo 0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'
NEG_INVALID_ROOT_BINDING_TX_CMD='echo 0xdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'

# Optional signer declarations (mode2 policy enforcement)
BOOTSTRAP_SIGNERS='0,1,2,3,4'
UPDATE_SIGNERS='0,1,2'
NEG_INVALID_SIGNER_SET_SIGNERS='0,1'
NEG_INVALID_ROOT_BINDING_SIGNERS='0,1,2'
